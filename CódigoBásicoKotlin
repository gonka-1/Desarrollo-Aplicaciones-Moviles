***Función de Orden Superior:*** 

	fun sumar(primer_numero: Int, segundo_numero: Int) = primer_numero + segundo_numero // Funcion de una sola expresión
  fun restar(primer_numero: Int, segundo_numero: Int) = primer_numero - segundo_numero
  fun multiplicar(primer_numero: Int, segundo_numero: Int) = primer_numero * segundo_numero
    
  fun operacion(primer_numero: Int, segundo_numero:Int, funcion: (Int, Int) -> Int): Int{
        //tengo un primer_numero, segundo_numero y función
        return funcion(primer_numero, segundo_numero)
    }
    
    
    var a = 3
    var b = 4

    //println(sumar(a, b))
    
    //println(restar(a, b))
    
    //println(multiplicar(a, b))
    
    println(operacion(a, b, ::multiplicar))
    
    //Los "::" sirven como el operador de referencia. Se usan para apuntar a una función, 
    //a una propiedad o a un constructor sin ejecutarlos de inmediato, permitiendo tratarlos como valores u objetos

