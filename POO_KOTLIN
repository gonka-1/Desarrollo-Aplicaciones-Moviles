open class Animal(var nombre: String,var edad: Int,var peso: Double){
    fun info(){
         println("El animal se llama $nombre, tiene $edad años y pesa $peso kg")
     }
     
     open fun ruido(){
         println("$nombre hace un ruido genérico")
     }//Cuando un método está en el concepto de polimorfismo pasa a ser "Open"
}//Clase padre siempre tiene que tener "Open"

class Gato(nombre: String, edad: Int, peso: Double, var vidas: Int):Animal(nombre, edad, peso){
    override fun ruido(){
         println("El gato $nombre hace MIAU")
     }//el metodo pasa a ser override(sobre escrito).
    fun romperSofa(){
        println("$nombre está rompiendo el sofa")
    }    
}//Clase hija Gato

class Perro(nombre: String, edad: Int, peso: Double, var labor: String):Animal(nombre, edad, peso){
    override fun ruido(){
         println("El perro $nombre hace GUAU")
     } 
    fun jugar(){
        println("$nombre está jugando")
    }
}//Clase hija Perro

fun main() { 
    val spike = Perro("Spike", 4, 7.5, "Compañia")
    val michi = Gato("Michi", 2, 2.5, 7)
    
    spike.ruido()
    michi.ruido()
    
    spike.jugar()
    michi.romperSofa()   

}

